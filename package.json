{
  "name": "pouchdb-load",
  "version": "1.4.6",
  "description": "PouchDB Load - load dumped CouchDB/PouchDB databases on the client",
  "main": "./lib/index.js",
  "repository": {
    "type": "git",
    "url": "git://github.com/nolanlawson/pouchdb-load.git"
  },
  "keywords": [
    "pouch",
    "pouchdb",
    "plugin",
    "load",
    "dump",
    "couchdb"
  ],
  "author": "Nolan Lawson <nolan.lawson@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nolanlawson/pouchdb-load/issues"
  },
  "scripts": {
    "jshint": "jshint -c .jshintrc lib test/test.js",
    "test": "npm run jshint && istanbul test ./node_modules/mocha/bin/_mocha test/test.js",
    "build": "mkdirp dist && browserify . -p bundle-collapser/plugin -s PouchDBLoad -t > dist/pouchdb.load.js && npm run min",
    "min": "uglifyjs dist/pouchdb.load.js -mc > dist/pouchdb.load.min.js",
    "coverage": "npm test --coverage && istanbul check-coverage --lines 100 --function 100 --statements 100 --branches 100",
    "dev-server": "./bin/dev-server.js",
    "test-browser-playwright": "npx playwright test"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "pouchdb-ajax": "5.4.5",
    "pouchdb-checkpointer": "5.4.5",
    "pouchdb-extend": "^0.1.2",
    "pouchdb-generate-replication-id": "5.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "browserify": "^13.0.1",
    "bundle-collapser": "^1.2.1",
    "chai": "^3.5.0",
    "chai-as-promised": "^5.3.0",
    "http-server": "^0.5.5",
    "istanbul": "^0.2.7",
    "jshint": "^2.13.6",
    "mkdirp": "^0.5.1",
    "mocha": "^2.5.3",
    "phantomjs-prebuilt": "^2.1.7",
    "pouchdb-memory": "^1.0.0",
    "uglify-js": "^3.19.3",
    "watchify": "^4.0.0"
  },
  "browser": {
    "http-server": false
  },
  "files": [
    "lib",
    "dist"
  ]
}
